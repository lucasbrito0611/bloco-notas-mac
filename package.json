{
  "name": "bloco-notas-mac",
  "version": "1.0.2",
  "description": "Clone do Apple Notes para Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "icon": "electron build/make-icon.cjs",
    "dist": "vite build && electron-builder --win --publish never"
  },
  "author": "Lucas Brito",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "productName": "Notas",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasbrito0611/bloco-notas-mac.git"
  },
  "build": {
    "appId": "com.lucas.notas",
    "productName": "Notas",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Notas-Setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Notas"
    },
    "publish": {
      "provider": "github",
      "owner": "lucasbrito0611",
      "repo": "bloco-notas-mac",
      "releaseType": "release"
    }
  }
}
